# Aura CRM — variables de entorno
# Copia este archivo a crm/.env y ajusta los valores.

# --- Base de datos ---
CRM_DATABASE_URL=postgres://usuario:password@localhost:5432/aura_crm

# --- Servidor ---
CRM_PORT=4100
NODE_ENV=development

# --- Sesión ---
CRM_SESSION_HOURS=12
# En producción detrás de HTTPS, deja esto en 1 (o simplemente NODE_ENV=production).
CRM_COOKIE_SECURE=0

# --- IA generativa (opcional) ---
# Sin esta llave, Aura funciona igual: el motor determinista calcula todo y el
# copiloto responde con plantillas. La llave solo mejora la redacción y la
# conversación libre.
ANTHROPIC_API_KEY=
CRM_IA_MODELO=claude-sonnet-5

# --- Semilla de datos de demostración ---
CRM_DEMO_PASSWORD=Aura2026!
CRM_SEED=20260729

# --- Programador interno (esperas de automatizaciones, cron, recálculo de IA) ---
# Poner en 0 si corres varias réplicas y solo una debe llevar el reloj.
CRM_PROGRAMADOR=1
