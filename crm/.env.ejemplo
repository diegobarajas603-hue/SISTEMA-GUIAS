# Copia a .env para desarrollo local. En Railway se cargan como variables del
# servicio, no como archivo.

# --- Base de datos -----------------------------------------------------------
# Railway inyecta DATABASE_URL solo si enlazas el servicio de Postgres.
# En local basta con la de abajo.
CRM_DATABASE_URL=postgres://postgres@localhost:5432/aura_crm
# El TLS se decide solo: activo para bases gestionadas, apagado en local y en
# redes internas del proveedor. Define esto únicamente si hace falta forzarlo.
# CRM_DB_SSL=true

# --- Servidor ----------------------------------------------------------------
# En Railway NO definas PORT: la plataforma lo inyecta y el proceso lo respeta.
# CRM_PORT=4100
NODE_ENV=development

# --- Sesión ------------------------------------------------------------------
CRM_SESSION_HOURS=12
# En producción las cookies van solo por HTTPS de forma automática.
# CRM_COOKIE_SECURE=true

# --- Datos de demostración ---------------------------------------------------
# Con 1, el primer arranque siembra 18 meses de historia SOLO si la base está
# vacía. Ponlo en 0 cuando vayas a cargar tus datos reales.
CRM_SEMILLA_INICIAL=0
CRM_DEMO_PASSWORD=Aura2026!

# --- IA generativa (opcional) ------------------------------------------------
# Sin clave el producto funciona completo con el motor determinista.
# ANTHROPIC_API_KEY=
# CRM_IA_MODELO=claude-sonnet-5
