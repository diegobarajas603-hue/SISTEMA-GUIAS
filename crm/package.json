{
  "name": "aura-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Aura CRM - plataforma comercial inteligente (Fletes Tauro)",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace api",
    "db:migrar": "npm run db:migrar --workspace api",
    "db:semilla": "npm run db:semilla --workspace api",
    "db:reiniciar": "npm run db:reiniciar --workspace api",
    "typecheck": "npm run typecheck --workspace web",
    "prueba:api": "node api/pruebas/humo.mjs",
    "prueba:ui": "node pruebas/humo-ui.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
