# Proyecto de Supabase (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Dominio de los enlaces de invitación: https://<dominio>/invite/XXXXXXXX
EXPO_PUBLIC_INVITE_DOMAIN=orbita.app

# Google Maps (sólo Android; en iOS se usa Apple Maps)
GOOGLE_MAPS_ANDROID_API_KEY=

# ID del proyecto EAS (necesario para notificaciones push)
EAS_PROJECT_ID=

# (Opcional) Mostrar "Continuar con Google" (configúralo antes en Supabase → Auth → Providers)
EXPO_PUBLIC_ENABLE_GOOGLE=false
