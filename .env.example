# Puerto del servidor
PORT=3000

# Ruta del archivo de base de datos SQLite (persistente).
# En un servidor con volumen (Railway/Render), apunta a la carpeta montada,
# por ejemplo: /data/tauro-crm.db
DB_PATH=data/tauro-crm.db

# URL publica del sistema (se usa para las ligas de PDF que se mandan por
# WhatsApp/correo). Ejemplo: https://crm.fletestauro.com.mx
BASE_URL=

# --- Administrador inicial ---
# Se crea solo la primera vez que arranca el sistema (cuando no hay usuarios).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contrasena

# Horas que dura una sesion antes de pedir login de nuevo (12 por defecto)
SESSION_HOURS=12

# --- Correo (SMTP) ---
# Tambien se puede configurar desde el panel: Configuracion -> Correo.
# Lo que se capture en el panel tiene prioridad sobre estas variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_DE="Fletes Tauro <ventas@fletestauro.com.mx>"

# --- WhatsApp Business Cloud API (opcional) ---
# Si se dejan vacios, el envio por WhatsApp funciona igual con ligas wa.me
# (se abre WhatsApp con el mensaje y la liga del PDF ya escritos).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
